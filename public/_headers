# Cabeçalhos HTTP do Worker de assets (Cloudflare). HTML, sitemap, robots e llms sem cache longo.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# Endereço de teste: mesmo build da produção, fora do Google até "workers_dev": false (T10).
https://lauro-adv-br.lauro-adv.workers.dev/*
  X-Robots-Tag: noindex, nofollow
