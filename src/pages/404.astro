---
// Página de endereço inexistente. O Worker a serve com HTTP 404 (wrangler.jsonc: not_found_handling).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { waAttrs, msgGeral } from '../lib/whatsapp.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Página não encontrada | Dr. Lauro de Almeida Neto" description="Esta página não existe ou mudou de endereço." area="404" noindex>
  <section class="hero hero--index">
    <div class="container">
      <p class="label mono">Erro 404</p>
      <h1>Página não encontrada</h1>
      <p class="hero__lead">Você pode voltar ao início, consultar nossas áreas de atuação ou falar com o escritório.</p>
      <div class="final__actions hero__cta">
        <a class="btn btn--ghost" href={`${base}/`}>Voltar ao início</a>
        <a class="btn btn--ghost" href={`${base}/especialidades/`}>Áreas de atuação</a>
        <a class="btn btn--primary" {...waAttrs(msgGeral(), { area: '404', situacao: 'contato-geral', secao: '404' })}><Icon name="whatsapp" size={20} />Falar no WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>
