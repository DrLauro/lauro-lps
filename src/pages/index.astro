---
// Página principal (lauro.adv.br/). Reúne as áreas, os casos dos contextos e a triagem geral.
// Texto próprio desta página: ainda não está em CONTEXT.md, precisa do ok do Dr. Lauro.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Proof from '../components/Proof.astro';
import portrait from '../assets/dr-lauro.png';
import avatar from '../assets/dr-lauro-avatar.png';
import { pages, cards as areas, cardLink } from '../lib/contexts.mjs';
import { office } from '../lib/office.mjs';
import { publicacao } from '../lib/posts.mjs';
import { waAttrs, msgGeral } from '../lib/whatsapp.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Advogado Criminalista em Osasco e SP 24h | Dr. Lauro Neto';
const description = 'Dr. Lauro de Almeida Neto, advogado criminalista com mais de 23 anos de atuação. Prisão, inquérito, processo e recursos. Atendimento 24h em Osasco, SP e todo o Brasil.';
const canonical = 'https://lauro.adv.br/';

const situacoes = [
  'Alguém foi preso agora',
  'Recebi uma intimação ou estou sendo investigado',
  'Fui vítima de um crime',
  'Fui condenado e quero recorrer',
  'Outra situação criminal',
];
// data-situacao em slug sem acento (alguem-foi-preso-agora); texto visível e mensagem não mudam.
const slugify = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const wa = (situacao) =>
  waAttrs(`Olá, Dr. Lauro, vim pelo site: ${situacao[0].toLowerCase() + situacao.slice(1)}.`, { area: 'home', situacao: slugify(situacao), secao: 'triagem' });
const call = (secao) => ({ href: office.tel, 'data-track': 'phone_click', 'data-area': 'home', 'data-secao': secao });
const [primary, ...others] = situacoes;
const geral = (secao) => waAttrs(msgGeral(), { area: 'home', situacao: 'contato-geral', secao });

const passos = [
  ['Primeiro contato', 'Identificamos o assunto, a urgência, a cidade em que o caso tramita e a fase do procedimento.'],
  ['Análise dos documentos', 'Examinamos o que existe: boletim de ocorrência, intimação, mandado, decisão, denúncia ou sentença.'],
  ['Estratégia e acompanhamento', 'Você recebe as possibilidades de atuação e as providências iniciais e é informado de cada decisão relevante.'],
];

// "Artigos e Decisões": decisões favoráveis primeiro, depois artigos de análise (máx. 6).
// Cada card = caso aprovado no CONTEXT.md da área (texto sem dado identificável)
// + a publicação ligada ao caso ("Publicação: jusbrasil:<id>"): artigo do site, se houver, ou Jusbrasil.
const destaques = [
  ['prisao-em-flagrante', 0],
  ['habeas-corpus', 0],
  ['trafico-de-drogas', 0],
  ['lei-maria-da-penha', 0],
  ['crimes-patrimoniais', 0],
  ['crimes-patrimoniais', 1],
];
const destino = await publicacao();
const titulo = (t) => t.replace(/habeas corpus/gi, 'Habeas Corpus').replace(/tribunais superiores/gi, 'Tribunais Superiores');
const cards = destaques.map(([slug, i]) => {
  const p = pages.find((x) => x.slug === slug);
  const c = p.content.find((b) => b.kind === 'cases').items[i];
  return { area: p.card.title, areaHref: `${base}/${slug}/`, title: titulo(c.title), text: c.text, artigo: destino(c.jusbrasilId) };
});

const [escritorio, advogado] = pages[0].jsonLd['@graph'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [escritorio, advogado, { '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, provider: { '@id': escritorio['@id'] } }],
};
---
<BaseLayout title={title} description={description} canonical={canonical} area="home" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="ident">
          <Image src={avatar} alt="" width={96} height={96} class="ident__img" loading="eager" />
          <span class="ident__text"><strong>Dr. Lauro de Almeida Neto</strong><span>Advogado Criminalista</span></span>
        </div>
        <h1>Advogado criminalista em Osasco e São Paulo, com atuação em todo o Brasil</h1>
        <p class="hero__lead">Defesa criminal da delegacia aos tribunais superiores: prisão, inquérito, processo, recursos e execução da pena. Atendimento 24 horas, presencial ou online.</p>

        <div class="triage" role="group" aria-labelledby="triage-title">
          <p id="triage-title" class="label">Qual é a sua situação?</p>
          <a class="triage__primary" {...wa(primary)}>
            <Icon name="whatsapp" size={22} /><span>{primary}</span><Icon name="arrow" size={18} />
          </a>
          <ul class="triage__list">
            {others.map((s) => (
              <li><a class="triage__row" {...wa(s)}><Icon name="whatsapp" size={18} /><span>{s}</span><Icon name="arrow" size={16} /></a></li>
            ))}
            <li><a class="triage__row triage__row--call" {...call('triagem')}><Icon name="phone" size={18} /><span>Ligar <span class="mono">{office.phoneLabel}</span></span><Icon name="arrow" size={16} /></a></li>
          </ul>
        </div>
      </div>
      <figure class="hero__photo">
        <Image src={portrait} alt="Dr. Lauro de Almeida Neto, advogado criminalista, de terno azul-marinho" widths={[360, 450]} sizes="400px" loading="eager" fetchpriority="high" />
        <figcaption><strong>Dr. Lauro de Almeida Neto</strong><span>Advogado Criminalista</span></figcaption>
      </figure>
    </div>
  </section>

  <Proof items={pages[0].proof} />

  <section class="block block--prose" aria-labelledby="s1">
    <div class="container block__grid">
      <header class="block__head">
        <span class="block__mark mono" aria-hidden="true">§ 1</span>
        <h2 id="s1">Dr. Lauro de Almeida Neto</h2>
      </header>
      <div class="block__body">
        <p>Advogado inscrito na OAB/SP sob o nº 210.212, com mais de 23 anos de atuação concentrada em Direito Penal e Processo Penal.</p>
        <p>Nesse período, foram milhares de atendimentos, investigações, processos e recursos, em todas as fases do caso criminal: da delegacia aos tribunais superiores.</p>
        <p>Cada caso é analisado individualmente, considerando os fatos, os documentos, as provas e a fase do procedimento, com absoluto sigilo das informações. O atendimento é realizado presencialmente em Osasco e São Paulo ou online em todo o Brasil.</p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="s2" id="areas">
    <div class="container block__grid">
      <header class="block__head">
        <span class="block__mark mono" aria-hidden="true">§ 2</span>
        <h2 id="s2">Áreas de atuação</h2>
      </header>
      <ul class="area-index area-index--cols">
        {areas.map((c) => (
          <li>
            <a {...cardLink(c, base)}>
              <span class="mono area-index__n">{String(c.num).padStart(2, '0')}</span>
              <span class="area-index__name">{c.title}</span>
              <Icon name={c.slug ? 'arrow' : 'whatsapp'} size={18} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="s3">
    <div class="container block__grid">
      <header class="block__head">
        <span class="block__mark mono" aria-hidden="true">§ 3</span>
        <h2 id="s3">Como funciona o atendimento</h2>
      </header>
      <ol class="steps block__body">
        {passos.map(([t, d], i) => (
          <li>
            <span class="mono steps__n">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{t}</h3><p>{d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="s4" id="artigos">
    <div class="container block__grid">
      <header class="block__head">
        <span class="block__mark mono" aria-hidden="true">§ 4</span>
        <h2 id="s4">Artigos e Decisões</h2>
      </header>
      <div class="block__body">
        <div class="cases">
          {cards.map((c) => (
            <article class="case case--card">
              <a class="label case__area" href={c.areaHref}>{c.area}</a>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              {c.artigo
                ? <a class="posts__more" href={c.artigo.href} {...(c.artigo.external && { target: '_blank', rel: 'noopener' })} data-track="blog_click" data-area="home" data-secao="artigos-home">Ler artigo <Icon name="arrow" size={16} /></a>
                : <a class="posts__more" href={c.areaHref}>Ver a área <Icon name="arrow" size={16} /></a>}
            </article>
          ))}
        </div>
        <p class="cases__note">Resultados anteriores não garantem resultado em outros casos. Cada situação depende da análise dos fatos e das provas.</p>
        <a class="btn btn--ghost posts__all" href={`${base}/blog/`}>Ver todos os artigos<Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="final" aria-label="Fale com o Dr. Lauro">
    <div class="container final__in">
      <div class="final__copy">
        <p class="final__text">A liberdade não tem preço.</p>
        <p class="final__sub">Quando sua liberdade está em jogo, procure um advogado com experiência na área criminal. Uma defesa qualificada desde o primeiro momento pode fazer a diferença em todas as etapas do processo.</p>
        <p class="final__close">Se é importante para você, é importante para nós.</p>
      </div>
      <div class="final__actions">
        <a class="btn btn--primary" {...geral('final')}><Icon name="whatsapp" size={20} />Falar no WhatsApp</a>
        <a class="btn btn--on-dark" {...call('final')}><Icon name="phone" size={20} />Ligar <span class="mono">{office.phoneLabel}</span></a>
      </div>
    </div>
  </section>

  <div class="sticky-cta">
    <a class="btn btn--primary" {...geral('sticky')}><Icon name="whatsapp" size={20} />WhatsApp</a>
    <a class="btn btn--ghost" {...call('sticky')}><Icon name="phone" size={20} />Ligar</a>
  </div>
</BaseLayout>
