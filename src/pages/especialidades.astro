---
// Índice das áreas (/especialidades/, destino do breadcrumb das LPs). Card: src/data/cards-areas.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Contato from '../components/Contato.astro';
import { cards, cardLink } from '../lib/contexts.mjs';
import { waAttrs, msgGeral } from '../lib/whatsapp.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Áreas de atuação | Dr. Lauro de Almeida Neto" description="Áreas de atuação do Dr. Lauro de Almeida Neto, advogado criminalista em Osasco e São Paulo." canonical="https://lauro.adv.br/especialidades/" area="especialidades">
  <section class="hero hero--index">
    <div class="container">
      <p class="label">Advocacia criminal · {cards.length} áreas</p>
      <h1>Áreas de atuação</h1>
      <a class="btn btn--primary hero__cta" {...waAttrs(msgGeral(), { area: 'especialidades', situacao: 'contato-geral', secao: 'topo' })}><Icon name="whatsapp" size={20} />Falar no WhatsApp</a>
    </div>
  </section>
  <section class="block">
    <div class="container">
      <ul class="area-index area-index--desc">
        {cards.map((c) => (
          <li>
            <a {...cardLink(c, base)}>
              <span class="mono area-index__n">{String(c.num).padStart(2, '0')}</span>
              <span>
                <span class="area-index__name">{c.title}</span>
                {c.text && <span class="area-index__desc">{c.text}</span>}
              </span>
              <Icon name={c.slug ? 'arrow' : 'whatsapp'} size={18} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Contato area="especialidades" text="Não encontrou sua situação? Fale com o escritório para identificar o atendimento adequado ao seu caso." />
</BaseLayout>
