---
// Todos os artigos: os escritos no site e os antigos do Jusbrasil (src/lib/posts.mjs).
// Os marcados com `fim` (fora da área criminal) ficam sob "Outros temas", no fim.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Posts from '../../components/Posts.astro';
import Icon from '../../components/Icon.astro';
import Contato from '../../components/Contato.astro';
import { loadPosts } from '../../lib/posts.mjs';
import { waAttrs, msgGeral } from '../../lib/whatsapp.mjs';

const posts = await loadPosts();
const criminais = posts.filter((p) => !p.fim);
const outros = posts.filter((p) => p.fim);
---
<BaseLayout title="Artigos e Decisões | Dr. Lauro de Almeida Neto" description="Artigos do Dr. Lauro de Almeida Neto, advogado criminalista, sobre prisão, provas, habeas corpus, recursos e decisões dos tribunais." canonical="https://lauro.adv.br/blog/" area="blog">
  <section class="hero hero--index">
    <div class="container">
      <p class="label">{posts.length} artigos</p>
      <h1>Artigos e Decisões</h1>
      <a class="btn btn--primary hero__cta" {...waAttrs(msgGeral(), { area: 'blog', situacao: 'contato-geral', secao: 'topo' })}><Icon name="whatsapp" size={20} />Falar no WhatsApp</a>
    </div>
  </section>
  <section class="block">
    <div class="container">
      <Posts posts={criminais} />
      {outros.length > 0 && (
        <>
          <h2 class="posts__group">Outros temas</h2>
          <Posts posts={outros} />
        </>
      )}
    </div>
  </section>
  <Contato area="blog" text="Precisa de orientação sobre uma situação semelhante? Fale com o Dr. Lauro." />
</BaseLayout>
