---
// Uma rota para cada área. Conteúdo vem de contexts/*.CONTEXT.md via src/lib/contexts.mjs.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Proof from '../components/Proof.astro';
import portrait from '../assets/dr-lauro.png';
import avatar from '../assets/dr-lauro-avatar.png';
import { pages } from '../lib/contexts.mjs';
import { office } from '../lib/office.mjs';
import { waAttrs, msgArea } from '../lib/whatsapp.mjs';
import { publicacao } from '../lib/posts.mjs';

export const getStaticPaths = () => pages.map((p) => ({ params: { slug: p.slug }, props: { p } }));

const { p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bySlug = Object.fromEntries(pages.map((x) => [`/${x.slug}/`, x]));
const related = p.links.filter((l) => bySlug[l.path]).map((l) => bySlug[l.path]);
const [primary, ...others] = p.whatsapp;
const sections = p.content.filter((b) => b.kind !== 'cases' || b.items.length);
const wa = (w) => ({ href: w.href, target: '_blank', rel: 'noopener', 'data-track': 'whatsapp_click', 'data-area': p.area, 'data-situacao': w.situacao, 'data-secao': 'triagem' });
// Final e barra fixa: mensagem neutra, sem presumir se quem clica é vítima ou acusado.
const geral = (secao) => waAttrs(msgArea(p.name), { area: p.area, situacao: 'contato-geral', secao });
// Páginas com público de vítimas que ganham, abaixo da triagem, o link para /sou-vitima/.
const COM_LINK_VITIMA = ['lei-maria-da-penha', 'golpes-e-fraudes-digitais', 'ofensas-digitais', 'crimes-sexuais', 'tribunal-do-juri'];
// Números do aviso de emergência viram links de discagem (sem data-track: não é conversão).
const avisoPartes = p.aviso?.split(/\b(190|180)\b/) ?? [];
const destino = await publicacao();
const lerArtigo = (c) => {
  const d = destino(c.jusbrasilId);
  return d && { href: d.href, ...(d.external && { target: '_blank', rel: 'noopener' }), 'data-track': 'blog_click', 'data-area': p.area, 'data-secao': 'casos' };
};
const call = (secao) => ({ href: p.phone.href, 'data-track': 'phone_click', 'data-area': p.area, 'data-secao': secao });
---
<BaseLayout title={p.title} description={p.description} canonical={p.canonical} area={p.area} jsonLd={p.jsonLd} waText={msgArea(p.name)}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <nav class="crumbs mono" aria-label="Você está em">
          <a href={`${base}/especialidades/`}>Áreas de atuação</a><span aria-hidden="true">/</span><span aria-current="page">{p.name}</span>
        </nav>
        <div class="ident">
          <Image src={avatar} alt="" width={96} height={96} class="ident__img" loading="eager" />
          <span class="ident__text"><strong>Dr. Lauro de Almeida Neto</strong><span class="mono">OAB/SP 210.212</span></span>
        </div>
        <h1>{p.hero.h1}</h1>
        <p class="hero__lead">{p.hero.text}</p>

        <div class="triage" role="group" aria-labelledby="triage-title">
          <p id="triage-title" class="label">Qual é a sua situação?</p>
          <a class="triage__primary" {...wa(primary)}>
            <Icon name="whatsapp" size={22} /><span>{primary.label}</span><Icon name="arrow" size={18} />
          </a>
          <ul class="triage__list">
            {others.map((w) => (
              <li><a class="triage__row" {...wa(w)}><Icon name="whatsapp" size={18} /><span>{w.label}</span><Icon name="arrow" size={16} /></a></li>
            ))}
            <li><a class="triage__row triage__row--call" {...call('triagem')}><Icon name="phone" size={18} /><span>Ligar <span class="mono">{office.phoneLabel}</span></span><Icon name="arrow" size={16} /></a></li>
          </ul>
          {p.aviso && (
            <p class="triage__aviso" role="note">
              {avisoPartes.map((t, i) => (i % 2 ? <a href={`tel:${t}`} class="mono">{t}</a> : t))}
            </p>
          )}
          {COM_LINK_VITIMA.includes(p.slug) && (
            <a class="triage__vitima" href={`${base}/sou-vitima/`}>Saiba como atuamos para vítimas<Icon name="arrow" size={16} /></a>
          )}
        </div>
      </div>
      <figure class="hero__photo">
        <Image src={portrait} alt="Dr. Lauro de Almeida Neto, advogado criminalista, de terno azul-marinho" widths={[360, 450]} sizes="400px" loading="eager" fetchpriority="high" />
        <figcaption><strong>Dr. Lauro de Almeida Neto</strong><span class="mono">Advogado criminalista · OAB/SP 210.212</span></figcaption>
      </figure>
    </div>
  </section>

  <Proof items={p.proof} />

  {sections.map((b, i) => (
    <section class={`block block--${b.kind}`} aria-labelledby={`s${i + 1}`}>
      <div class="container block__grid">
        <header class="block__head">
          <span class="block__mark mono" aria-hidden="true">§ {i + 1}</span>
          <h2 id={`s${i + 1}`}>{b.h2}</h2>
        </header>
        <div class="block__body">
          {b.kind === 'prose' && b.items.map((t) => <p>{t}</p>)}
          {b.kind === 'chips' && <ul class="chips">{b.items.map((t) => <li>{t}</li>)}</ul>}
          {b.kind === 'links' && (
            <div class="related">
              {b.intro.map((t) => <p>{t}</p>)}
              <ul>{b.items.filter((l) => bySlug[l.path]).map((l) => <li><a href={`${base}${l.path}`}><span>{l.label}</span><Icon name="arrow" size={16} /></a></li>)}</ul>
            </div>
          )}
          {b.kind === 'list' && (
            <ul class="checks">{b.items.map((t) => <li><Icon name="check" size={18} /><span>{t}</span></li>)}</ul>
          )}
          {b.kind === 'cases' && (
            <div class="cases">
              {b.items.map((c, n) => (
                <article class="case">
                  <p class="label">Caso {String(n + 1).padStart(2, '0')}</p>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                  {lerArtigo(c) && <a class="posts__more" {...lerArtigo(c)}>Ler artigo <Icon name="arrow" size={16} /></a>}
                </article>
              ))}
            </div>
          )}
          {b.kind === 'faq' && (
            <div class="faq">
              {b.items.map((f) => (
                <details>
                  <summary><h3>{f.q}</h3><Icon name="plus" size={20} /></summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="final" aria-label="Fale com o Dr. Lauro">
    <div class="container final__in">
      <p class="final__text">{p.finalCta}</p>
      <div class="final__actions">
        <a class="btn btn--primary" {...geral('final')}><Icon name="whatsapp" size={20} />Falar no WhatsApp</a>
        <a class="btn btn--on-dark" {...call('final')}><Icon name="phone" size={20} />Ligar <span class="mono">{office.phoneLabel}</span></a>
      </div>
    </div>
  </section>

  <div class="container page-foot">
    {related.length > 0 && (
      <nav aria-labelledby="rel-title" class="related">
        <p id="rel-title" class="label">Áreas relacionadas</p>
        <ul>{related.map((r) => <li><a href={`${base}/${r.slug}/`}><span>{r.name}</span><Icon name="arrow" size={16} /></a></li>)}</ul>
      </nav>
    )}
    <p class="page-foot__legal">{p.pageFooter}</p>
  </div>

  <div class="sticky-cta">
    <a class="btn btn--primary" {...geral('sticky')}><Icon name="whatsapp" size={20} />WhatsApp</a>
    <a class="btn btn--ghost" {...call('sticky')}><Icon name="phone" size={20} />Ligar</a>
  </div>
</BaseLayout>
