---
// Lista de publicações do Jusbrasil (src/lib/jusbrasil.mjs). Cada item abre o artigo original.
import Icon from './Icon.astro';
const { posts } = Astro.props;
const fmt = (iso) => new Date(iso).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a href={p.url} target="_blank" rel="noopener" data-track="blog_click" data-area="blog">
        <time class="mono label" datetime={p.date}>{fmt(p.date)}</time>
        <h3>{p.title}</h3>
        <p>{p.excerpt}</p>
        <span class="posts__more">Ler no Jusbrasil <Icon name="arrow" size={16} /></span>
      </a>
    </li>
  ))}
</ul>
