---
// Lista de artigos (src/lib/posts.mjs). Os do site abrem aqui; os antigos abrem no Jusbrasil.
import Icon from './Icon.astro';
const { posts } = Astro.props;
const fmt = (iso) => new Date(iso).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a href={p.url} {...(p.external && { target: '_blank', rel: 'noopener' })} data-track="blog_click" data-area="blog">
        <time class="mono label" datetime={p.date}>{fmt(p.date)}</time>
        <h3>{p.title}</h3>
        <p>{p.excerpt}</p>
        <span class="posts__more">{p.external ? 'Ler no Jusbrasil' : 'Ler artigo'} <Icon name="arrow" size={16} /></span>
      </a>
    </li>
  ))}
</ul>
